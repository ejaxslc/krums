{
  // Serves the existing static site for the krums Worker. The name matches
  // the Worker already connected in Workers Builds.
  // html_handling is omitted so Workers uses the default auto-trailing-slash:
  // / serves index.html, and /shop resolves to shop.html.
  "name": "krums",
  "compatibility_date": "2026-10-16",
  "assets": {
    "directory": "./"
  }
}
